#!/bin/bash
#
# chkconfig: 2345 85 15
# description: Pure-FTPd is an FTP server daemon based upon Troll-FTPd
# processname: pure-ftpd

### BEGIN INIT INFO
# Provides:          pureftpd
# Required-Start:    $all
# Required-Stop:     $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: starts pureftpd server
# Description:       starts pureftpd server
### END INIT INFO

# Author:   licess
# website:  https://lnmp.org

# Pure-FTPd Settings
PURE_FTPD="/usr/local/pureftpd/sbin/pure-ftpd"
PURE_CONF="/usr/local/pureftpd/etc/pure-ftpd.conf"
PURE_PID="/var/run/pure-ftpd.pid"
RETVAL=0
prog="Pure-FTPd"

start() {
    echo -n $"Starting $prog... "
    "$PURE_FTPD" "$PURE_CONF"
    RETVAL=$?
    if [ "$RETVAL" = 0 ] ; then
        echo " done"
    else
        echo " failed"
    fi
    return "$RETVAL"
}

stop() {
    echo -n $"Stopping $prog...  "
    if ! status >/dev/null; then
        echo -n $"$prog is not running."
        return 1
    fi
    local Daemon_PID
    IFS= read -r Daemon_PID < "$PURE_PID" || return 1
    kill "$Daemon_PID"
    RETVAL=$?
    if [ "$RETVAL" = 0 ] ; then
        echo " done"
    else
        echo " failed"
    fi
    return "$RETVAL"
}

restart(){
    echo $"Restarting $prog..."
    stop || return $?
    sleep 2
    start
}

status(){
    local Daemon_PID='' Running=n
    if [ -r "$PURE_PID" ]; then IFS= read -r Daemon_PID < "$PURE_PID"; fi
    if [[ "$Daemon_PID" =~ ^[1-9][0-9]*$ ]] && [ "$Daemon_PID" -gt 1 ] && kill -0 "$Daemon_PID" 2>/dev/null; then
        Running=y
        if [ -d /proc ]; then
            [ "$(readlink -f "/proc/$Daemon_PID/exe")" = "$(readlink -f "$PURE_FTPD")" ] || Running=n
        fi
    fi
    if [ "$Running" = y ]; then
        echo $"$prog is running."
        return 0
    else
        echo $"$prog is not running."
        return 3
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
  *)
        echo $"Usage: $0 {start|stop|restart}"
        exit 2
esac
